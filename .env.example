# ==============================================================
# J. Sethuraman Portfolio - Production Environment Variables Template
# Copy this file to .env and fill in your actual production values.
# NEVER commit your real .env file with production secrets to Git!
# ==============================================================

# Server Configuration
SERVER_PORT=8080

# MySQL Database Configuration
# Format: jdbc:mysql://<host>:<port>/<database_name>?<options>
DB_URL=jdbc:mysql://localhost:3306/portfolio_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_secure_password_here

# Admin Authentication Credentials
# Local default username: sethu_admin
ADMIN_USERNAME=sethu_admin

# BCrypt password hash (Cost factor 12)
# To generate a new hash: use Spring Security's BCryptPasswordEncoder or bcrypt.online
# Default local password is: sethu@2026!
ADMIN_PASSWORD_HASH=$2a$12$dP7DuEoTaUN/x6oFmEXd3e7q0kjCmktTzLp/GKeMi7RwrwbvdNaRq

# Gmail SMTP Configuration (for portfolio contact form)
# Generate a 16-character Google App Password from: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_google_app_password
CONTACT_RECIPIENT_EMAIL=your_email@gmail.com
